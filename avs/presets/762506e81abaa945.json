","inAdjustBlend":128,"outAdjustBlend":128,"inBuffer":0,"outBuffer":0,"inBufferInvert":false,"outBufferInvert":false,"enableOnBeat":false,"enableOnBeatFor":1,"code":{"enabled":"false","init":"","perFrame":""},"components":[{"type":"ColorMap","group":"Trans","key":"RED","blendMode":"REPLACE","mapCycleMode":"ONBEAT_SEQUENTIAL","adjustBlend":0,"dontSkipFastBeats":true,"cycleSpeed":51,"maps":[{"index":0,"enabled":true,"colors":[{"color":"#105f67","position":67},{"color":"#00bb88","position":182},{"color":"#cfff75","position":255}],"id":90410896,"fileName":"Cube.clm"},{"index":1,"enabled":true,"colors":[{"color":"#661131","position":67},{"color":"#ff8617","position":192},{"color":"#ffb70f","position":233},{"color":"#ffdb0f","position":255}],"id":17350504,"fileName":"Cube.clm"}]},{"type":"BufferSave","group":"Misc","action":"SAVE","bufferId":2}]}]},{"type":"ColorMap","group":"Trans","key":"RED","blendMode":"REPLACE","mapCycleMode":"SINGLE","adjustBlend":0,"dontSkipFastBeats":false,"cycleSpeed":8,"maps":[{"index":0,"enabled":true,"colors":[{"color":"#000000","position":13},{"color":"#1e2c35","position":35}],"id":552349312,"fileName":""}]},{"type":"EffectList","enabled":true,"clearFrame":true,"input":"IGNORE","output":"SUB_DEST_SRC","inAdjustBlend":128,"outAdjustBlend":128,"inBuffer":0,"outBuffer":0,"inBufferInvert":false,"outBufferInvert":false,"enableOnBeat":false,"enableOnBeatFor":1,"code":{"enabled":"false","init":"","perFrame":""},"components":[{"type":"DynamicMovement","group":"Trans","code":{"init":"t=rand(100);rx=1.57;ry=1.57;rx=0;ry=0;pt=0;bt=0","perFrame":"sd=sd*.9+getspec(0,.1,0)*.1;\r\nsd2=sd2*.9+getspec(0,.05,0)*.1;\r\nt=t+0.19+sd*.75;pt=pt+.25+sd2*.5;\r\nox=sin(pt*.1231);oy=sin(pt*.1);oz=cos(pt*.0913);\r\nol=-bt*.5+3/sqrt(sqr(ox)+sqr(oy)+sqr(oz));\r\nox=ox*ol;oy=oy*ol;oz=oz*ol;\r\nrxo=sin(t*.0373)*cos(t*0.0563)*sin(cos(t*.0631))*.5;\r\nryo=sin(t*.0511)*cos(t*0.071)*sin(cos(t*.0415))*.5;\r\nry=-atan2(ox,oz)+ryo;\r\nrx=-atan2(oy,sqrt(sqr(ox)+sqr(oz)))+rxo;\r\nrz=sin(t*.053)*cos(t*.117)*sin(cos(t*.0651));\r\ncx=cos(rx);sx=sin(rx);cy=cos(ry);sy=sin(ry);cz=cos(rz);sz=sin(rz);\r\nbt=bt*.9;af=h/w\r\n","onBeat":"pt=pt+55*max(0,getspec(0,.1,0)*3-1.5);\r\nbt=1","perPoint":"y=y*af;\r\ndx1=x*cz-y*sz;\r\ndy1=x*sz+y*cz;\r\ndy2=dy1*cx-1.2*sx;\r\ndz2=dy1*sx+1.2*cx;\r\ndx3=dx1*cy-dz2*sy;\r\ndz3=dx1*sy+dz2*cy;\r\nk1=((oz-sign(dz3))/dz3);\r\nk1=if(below(k1,0),-1000,k1);\r\nk2=((oy-sign(dy2))/dy2);\r\nk2=if(below(k2,0),-1000,k2);\r\nk3=((ox-sign(dx3))/dx3);\r\nk3=if(below(k3,0),-1000,k3);\r\nk=max(max(k1,k2),k3);\r\nix=-ox+dx3*k;iy=-oy+dy2*k;iz=-oz+dz3*k;\r\nalpha=bnot(equal(k,-100));\r\nx=if(equal(k,k3),iy,ix)*.9;\r\ny=if(equal(k,k1),iy,iz)*.9;\r\nd=max(abs(x),abs(y));\r\nalpha=if(bor(above(k,10),below(k,0)),0,1.8-sqr(d+.5)+.2);\r\n\r\n"},"bFilter":false,"coord":"CARTESIAN","gridW":30,"gridH":30,"blend":true,"wrap":false,"buffer":1,"alphaOnly":true},{"type":"BufferSave","group":"Misc","action":"SAVE","bufferId":1,"blendMode":"FIFTY_FIFTY","adjustBlend":0},{"type":"ColorMap","group":"Trans","key":"CHANNEL_SUM_HALF","blendMode":"REPLACE","mapCycleMode":"SINGLE","adjustBlend":0,"dontSkipFastBeats":false,"cycleSpeed":8,"maps":[{"index":0,"enabled":true,"colors":[{"color":"#000000","position":0},{"color":"#ffffff","position":167}],"id":419761888,"fileName":""}]}]},{"type":"BufferSave","group":"Misc","action":"RESTORE","bufferId":0,"blendMode":"FIFTY_FIFTY","adjustBlend":2}]}