{"name":"02 duo__incantation_(skupers_remixed)","date":"2003-03-20T19:21:28.000Z","clearFrame":true,"components":[{"type":"Comment","group":"Misc","text":"\r\n. incantation ( skupers taking control remix )\r\n. duo / brad candullo / http://duo.deviantART.com"},{"type":"EffectList","enabled":true,"clearFrame":false,"input":"IGNORE","output":"REPLACE","inAdjustBlend":128,"outAdjustBlend":218,"inBuffer":0,"outBuffer":0,"inBufferInvert":false,"outBufferInvert":false,"enableOnBeat":false,"enableOnBeatFor":1,"components":[{"type":"BufferSave","group":"Misc","action":"RESTORE","bufferId":0,"blendMode":"REPLACE","adjustBlend":6},{"type":"DynamicMovement","group":"Trans","code":{"init":"pbx=0; pby=.5; bgs=.05; rdn=10;","perFrame":"pfx=pfx+pbx-(pfx*.05);\r\npfy=pfy+pby-(pfy*.05);\r\npf=pf+pbg-tan(pf*.05);\r\nrs=sin(pf*.2); rc=cos(pf*.2);\r\n","onBeat":"pbx=rand(50)/100;\r\npby=rand(50)/100;\r\nbgs=getspec(0,0,2)*.7;\r\nrdn=1+rand(10);","perPoint":"x1=x+(bgs*.055+.005)*sin((d*rdn)+y*(rdn+sin(pf))+pfx*(.65));\r\ny1=y+(bgs*.055+.005)*cos((d*rdn)+x*(rdn+cos(pf))+pfy*(.65));\r\nz1=r*abs(sin(rc*rs+pfx*.005)*.5); x=x1/(1+z1)+sin(sin(atan(pf))+sin(pf*rdn)*.2); y=y1/(1+z1);"},"bFilter":true,"coord":"CARTESIAN","gridW":3,"gridH":3,"blend":false,"wrap":false,"buffer":0,"alphaOnly":false},{"type":"Colorfade","group":"Trans","enabled":true,"onBeat":"false","onBeatRandom":false,"fader1":-32,"fader2":7,"fader3":-32,"beatFader1":-32,"beatFader2":18,"beatFader3":5},{"type":"Blur","group":"Trans","blur":"LIGHT"}]},{"type":"UniqueTone","group":"Trans","enabled":true,"color":"#ff8448","blendMode":"REPLACE","invert":false},{"type":"EffectList","enabled":true,"clearFrame":true,"input":"IGNORE","output":"MAXIMUM","inAdjustBlend":128,"outAdjustBlend":128,"inBuffer":0,"outBuffer":0,"inBufferInvert":false,"outBufferInvert":true,"enableOnBeat":false,"enableOnBeatFor":1,"components":[{"type":"SuperScope","group":"Render","code":{"init":"n=200;pi=acos(-1);xasp=min(h/w,1);yasp=min(w/h,1);","perFrame":"xm1=xm1+xm1r;ym1=ym1+ym1r;xm=sin(xm1)*0.4;ym=sin(ym1)*0.4;redf=redf+redr;greenf=greenf+greenr;bluef=bluef+bluer;rx=rx+rxo;ry=ry+ryo;rz=rz+rzo;rzo=rzo*0.97;cx=cos(sin(rx));sx=sin(sin(rx));cy=cos(sin(ry));sy=sin(sin(ry));cz=cos(rz);sz=sin(rz);","onBeat":"xm1r=getosc(0.2,0,0)/5;ym1r=getosc(0.3,0,0)/8;redr=rand(10)/100-0.05;greenr=rand(10)/100-0.05;bluer=rand(10)/100-0.05;rxo=getosc(0.5,0.02,0)/15;ryo=getosc(0.3,0.02,0)/15;rzo=-abs(getosc(0.7,0.02,0)/4)-0.05;","perPoint":"k=getspec(i*80*n%n/n,1/n,0);\r\nr=i*pi*2;d=getspec(.3,0,1)+.25+k;\r\nx1=cos(r*4)*d;\r\ny1=sin(r)*d*cos(i*99);\r\nz1=cos(r)*d*sin(i*99);\r\n\r\nx1d=x1*cz-y1*sz;\r\ny1d=x1*sz+y1*cz;\r\ny2d=y1d*cx-z1*sx;\r\nz2d=y1d*sx+z1*cx;\r\nx3d=x1d*cy-z2d*sy;\r\nz3d=x1d*sy+z2d*cy;\r\nzi=1/(z3d+3);\r\nx=if(above(z3d+3,0.1),x3d*zi,x)*xasp-xm;\r\ny=if(above(z3d+3,0.1),y2d*zi,y)*yasp-ym;\r\n\r\nalpha=if(below(z3d+2.4,0),0,1);\r\nred=alpha*(1+k)/(3+sin(redf))*(1-z3d);\r\nblue=alpha*k/(4+sin(bluef))*(1-z3d);\r\ngreen=alpha*k/(3+sin(greenf))*(1-z3d);"},"audioChannel":"CENTER","audioSource":"WAVEFORM","colors":["#ffffff"],"drawMode":"DOTS"},{"type":"Texer","group":"Misc","image":"skupers_lp6_01.bmp","input":"REPLACE","blendMode":"TEXTURE","particles":1024},{"type":"ColorMap","group":"Trans","key":"CHANNEL_SUM_HALF","blendMode":"ADDITIVE","mapCycleMode":"SINGLE","adjustBlend":0,"dontSkipFastBeats":false,"cycleSpeed":0,"maps":[{"index":0,"enabled":true,"colors":[{"color":"#000000","position":0},{"color":"#ffffff","position":42},{"color":"#000000","position":147},{"color":"#000000","position":255}],"id":30694632,"fileName":""}]},{"type":"BufferSave","group":"Misc","action":"SAVE","bufferId":1,"blendMode":"REPLACE","adjustBlend":0}]},{"type":"UniqueTone","group":"Trans","enabled":true,"color":"#0000ff","blendMode":"ADDITIVE","invert":true},{"type":"Invert","group":"Trans","enabled":true},{"type":"EffectList","enabled":false,"clearFrame":false,"input":"REPLACE","output":"BUFFER","inAdjustBlend":128,"outAdjustBlend":128,"inBuffer":0,"